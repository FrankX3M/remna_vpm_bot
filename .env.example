BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую
ADMIN_IDS=111111111,222222222

# --- Выход к Telegram (в РФ заблокирован) ---
# Пусто = напрямую: сервер в сети роутера с VPN (западный выход) или сам с западным IP.
# Иначе: socks5://tg-egress:1080 (контейнер Xray -> FIN) и COMPOSE_PROFILES=egress ниже.
# Оба параметра выставляет 07-bot-home.sh сам.
TELEGRAM_PROXY=
COMPOSE_PROFILES=

# --- Remnawave (панель на этом же сервере) ---
# Бот в docker-сети панели обращается к backend напрямую по http, поэтому BEHIND_PROXY=true
# (панель требует заголовки X-Forwarded-*, иначе вернёт ошибку).
REMNAWAVE_URL=http://remnawave:3000
REMNAWAVE_BEHIND_PROXY=true
# API-токен: панель -> Settings -> API Tokens. Отдельный токен для бота, не тот, что у subscription-page.
REMNAWAVE_TOKEN=eyJhbGciOi...
# Если в ответе панели нет subscriptionUrl — ссылка соберётся как SUB_BASE_URL/shortUuid
SUB_BASE_URL=https://sub.1rtp.ru
# UUID внутренних сквадов через запятую (какие ноды получают новые пользователи). Без них доступа к нодам не будет!
SQUAD_UUIDS=
# Лимит трафика в ГБ в месяц (0 = безлимит)
TRAFFIC_LIMIT_GB=0
# Лимит устройств (0 = не задавать)
HWID_LIMIT=0

# --- База данных: PostgreSQL в контейнере postgres (docker compose сам собирает DATABASE_URL из пароля) ---
# 07-bot-home.sh генерирует пароль один раз. Менять после первого запуска нельзя без смены пароля внутри Postgres.
PG_PASSWORD=
# Для запуска вне docker (разработка/тесты) можно задать DATABASE_URL напрямую; sqlite+aiosqlite:///./vpnbot.db
# DATABASE_URL=

# --- Веб-админка (только локально: через туннель, как панель Remnawave) ---
WEB_ENABLED=true
# Адрес, на который ведёт ссылка из команды /web. Имя должно входить в сертификат (*.1rtp.ru) и
# указывать на 10.66.0.2 (hosts на устройстве админа). 07-bot-home.sh заполняет сам.
WEB_BASE_URL=
# Подпись cookie-сессий (генерируется скриптом). Смена секрета разлогинит всех.
WEB_SECRET=
WEB_SESSION_HOURS=12

# --- Значения по умолчанию для настроек ---
# Бизнес-параметры (пробный период, рефералы, тексты, лимиты, инструкции…) теперь меняются в веб-админке
# (раздел «Настройки»). Значения ниже используются только как стартовые, пока настройка не изменена в админке.

TRIAL_DAYS=30
REFERRAL_BONUS_DAYS=30
USERNAME_PREFIX=tg_
LOG_LEVEL=INFO

# Версия Xray для tg-egress (docker compose images -> впишите точную)
XRAY_TAG=latest
